# App core
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRE=7d

# MongoDB
MONGO_URI=mongodb://localhost:27017/skill_assessment

# WebSocket
WS_PATH=/ws

# Google OAuth (Drive + Calendar)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/oauth/google/callback
# Service account JSON path or inline JSON (preferred: file path on server)
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./secrets/google-service-account.json
# Drive
DRIVE_RECORDINGS_FOLDER_ID=your-drive-folder-id

# Microsoft (Graph) OAuth - Calendar
MS_CLIENT_ID=your-microsoft-client-id
MS_CLIENT_SECRET=your-microsoft-client-secret
MS_REDIRECT_URI=http://localhost:5000/api/oauth/microsoft/callback

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=scrollingtosleep@gmail.com
SMTP_PASS=bvbzufmtjxkwyrbb

# Recording/Transcription
RECORD_TMP_DIR=./tmp/recordings
FFMPEG_PATH=/usr/bin/ffmpeg
OPENAI_API_KEY=sk-your-openai-api-key

# Feature flags
FEATURE_RECORDING=true
FEATURE_TRANSCRIPTION=true
FEATURE_WHITEBOARD=true
FEATURE_BREAKOUTS=true
FEATURE_WEBINAR=true
FEATURE_CALENDAR=true

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_AUTH_MAX_REQUESTS=20

# Cleanup Configuration
RECORDING_EXPIRY_DAYS=30
CLEANUP_SCHEDULE="0 2 * * *"

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Security
HELMET_ENABLED=true
TRUST_PROXY=1