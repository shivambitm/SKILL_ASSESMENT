version: 1
services:
  - type: web
    name: skill-assessment-backend
    env: node
    plan: free
    buildCommand: npm install
    startCommand: npm start
    rootDir: backend
    envVars:
      NODE_ENV: production
      JWT_SECRET: your-super-secret-jwt-key-here
      JWT_EXPIRE: 7d
      DB_PATH: ./skill_assessment.db
      REDIS_HOST: localhost
      REDIS_PORT: 6379
      REDIS_PASSWORD:
      CORS_ORIGIN: https://skills.shivastra.in,http://localhost:5173
      VITE_API_URL: https://skills.shivastra.in
      RATE_LIMIT_WINDOW_MS: 60000
      RATE_LIMIT_MAX_REQUESTS: 300
      AUTH_RATE_LIMIT_MAX_REQUESTS: 20
      REDIS_ENABLED: true
      REDIS_OPTIONAL: true
      ADMIN_PASSCODE: admin

  - type: web
    name: skill-assessment-frontend
    env: static
    plan: free
    buildCommand: npm install && npm run build
    rootDir: frontend
    publishDir: build
    envVars:
      VITE_API_URL: https://skills.shivastra.in
